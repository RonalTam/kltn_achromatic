NODE_ENV=production
PORT=3001
API_PREFIX=api
API_PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://shop.example.com

DATABASE_URL=postgresql://achromatic:replace-me@postgres:5432/achromatic?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP: use an App Password, never your normal Google password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM="ACHROMATIC <your-account@gmail.com>"

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://api.example.com/api/payments/vnpay/return

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SWAGGER_ENABLED=false
